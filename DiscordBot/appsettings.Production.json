{
  "DiscordBot": {
    "Enabled": false,
    "StartupMode": "Gateway",
    "WebsiteUrl": "https://hub-thunder.online",
    "LogDirectory": "App_Data/Logs/DiscordBot",
    "Import": {
      "Transport": "DirectSql",
      "DataDirectory": "App_Data/DiscordBot",
      "DatabasePath": "imports.db",
      "StagingDirectory": "imports"
    },
    "Outbox": {
      "DataDirectory": "App_Data/DiscordBot",
      "DatabasePath": "outbox.db",
      "DispatchIntervalSeconds": 5,
      "InitialRetryDelaySeconds": 5,
      "MaxRetryDelaySeconds": 300,
      "LeaseSeconds": 90,
      "BatchSize": 25,
      "MaxConcurrentDeliveries": 4
    },
    "PremiumSync": {
      "ReconciliationMinutes": 15
    }
  }
}
